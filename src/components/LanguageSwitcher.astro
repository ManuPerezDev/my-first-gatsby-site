---
// ES / EN links. paths maps each language to the equivalent page; languages without one are not shown.
import { homePath, languages, useTranslations } from '../i18n'

const { lang, paths = Object.fromEntries(Object.keys(languages).map(code => [code, homePath(code)])) } = Astro.props
const t = useTranslations(lang)
---

<nav aria-label={t.languageLabel} class='flex items-center gap-1 font-mono text-sm tracking-widest uppercase'>
  {
    Object.keys(languages)
      .filter(code => paths[code])
      .map(code => (
        <a
          href={paths[code]}
          hreflang={code}
          lang={code}
          title={languages[code]}
        aria-label={languages[code]}
          aria-current={code === lang ? 'page' : undefined}
          class='rounded-full px-2 py-1 text-ink-faint transition-colors hover:text-accent aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent-ink'
        >
          {code}
        </a>
      ))
  }
</nav>
