---
import { stack } from '../data/stack'
import Icon from './Icon.astro'

const { lang } = Astro.props
const text = value => (typeof value === 'string' ? value : value[lang])
---

<div class='flex flex-col gap-10'>
  {
    stack.map(group => (
      <div>
        <h3 class='mb-4 font-mono text-sm tracking-widest text-ink-faint uppercase'>{text(group.title)}</h3>
        <ul class='flex flex-wrap gap-2'>
          {group.items.map(item => (
            <li class='flex items-center gap-2 rounded-full bg-accent-soft py-1.5 pr-3.5 pl-3 text-sm font-medium text-accent-ink'>
              <Icon name={item.icon} size='1.1em' class='shrink-0' />
              {text(item.name)}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
