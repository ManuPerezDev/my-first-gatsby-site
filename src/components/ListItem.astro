---
// Row of the experience and article lists: on desktop it gets a highlight on hover while the
// rest of the list fades. The parent <ol> needs the group/list class.
const { class: className = '' } = Astro.props
---

<li
  class={`group relative grid pb-1 transition-opacity sm:grid-cols-8 sm:gap-8 md:gap-4 lg:group-hover/list:opacity-50 lg:hover:opacity-100! ${className}`}
>
  <div
    class='absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-hover lg:group-hover:shadow-[inset_0_1px_0_0_var(--line)]'
  >
  </div>
  <slot />
</li>
