---
// Three-way theme selector. The active option is styled from data-theme-preference on <html>
// (set before paint, see global.css), and aria-pressed is kept in sync for screen readers.
import { useTranslations } from '../i18n'
import Icon from './Icon.astro'

const { lang = 'es' } = Astro.props
const t = useTranslations(lang)
const options = [
  { value: 'system', label: t.themeSystem, icon: 'tabler:device-desktop' },
  { value: 'light', label: t.themeLight, icon: 'tabler:sun' },
  { value: 'dark', label: t.themeDark, icon: 'tabler:moon' }
]
---

<div role='group' aria-label={t.themeLabel} class='inline-flex items-center gap-0.5 rounded-full border border-line p-0.5'>
  {
    options.map(option => (
      <button
        type='button'
        data-theme-option={option.value}
        aria-pressed='false'
        aria-label={option.label}
        title={option.label}
        class='cursor-pointer rounded-full p-1.5 text-ink-faint transition-colors hover:text-accent'
      >
        <Icon name={option.icon} size='18' />
      </button>
    ))
  }
</div>

<script>
  const buttons = [...document.querySelectorAll('[data-theme-option]')]

  const sync = () => {
    const preference = window.siteTheme.preference
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.themeOption === preference))
    }
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const rect = button.getBoundingClientRect()
      window.siteTheme.set(button.dataset.themeOption, { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 })
    })
  }

  document.addEventListener('themechange', sync)
  sync()
</script>
