---
import Icon from './Icon.astro'
---

<button
  type='button'
  data-theme-toggle
  aria-label='Cambiar entre modo claro y oscuro'
  class='cursor-pointer rounded-full p-1.5 text-ink-faint transition-colors hover:text-accent'
>
  <span class='block dark:hidden'><Icon name='tabler:moon' size='22' /></span>
  <span class='hidden dark:block'><Icon name='tabler:sun' size='22' /></span>
</button>

<script>
  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
      document.documentElement.setAttribute('data-theme', theme)
      try {
        window.localStorage.setItem('theme', JSON.stringify(theme))
      } catch (e) {}
    })
  }
</script>
