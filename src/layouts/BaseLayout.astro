---
import { Font } from 'astro:assets'
import Seo from '../components/Seo.astro'
import '../styles/global.css'

const { seo = {} } = Astro.props
---

<html lang='es'>
  <head>
    <Seo {...seo} />
    <Font cssVariable='--font-michroma' preload />
    <Font cssVariable='--font-exo' preload />
    <Font cssVariable='--font-share-tech-mono' />
    <script is:inline>
      ;(() => {
        const storedTheme = () => {
          try {
            const theme = JSON.parse(window.localStorage.getItem('theme'))
            return theme === 'light' || theme === 'dark' ? theme : null
          } catch (e) {
            return null
          }
        }
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)')
        const apply = () => {
          const theme = storedTheme() ?? (systemDark.matches ? 'dark' : 'light')
          document.documentElement.setAttribute('data-theme', theme)
        }
        apply()
        // Follow OS changes live (e.g. automatic dark mode at sunset) until the visitor picks a theme
        systemDark.addEventListener('change', () => {
          if (!storedTheme()) apply()
        })
      })()
    </script>
  </head>
  <body class='antialiased'>
    <slot />
  </body>
</html>
