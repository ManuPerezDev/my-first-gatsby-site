---
import { getCollection } from 'astro:content'
import ArticleList from '../components/ArticleList.astro'
import ExperienceList from '../components/ExperienceList.astro'
import Section from '../components/Section.astro'
import Sidebar from '../components/Sidebar.astro'
import Stack from '../components/Stack.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const sections = [
  { id: 'sobre-mi', title: 'Sobre mí' },
  { id: 'experiencia', title: 'Experiencia' },
  { id: 'stack', title: 'Stack' },
  { id: 'articulos', title: 'Artículos' }
]

const posts = (await getCollection('blog')).sort((a, b) => b.data.date - a.data.date)
---

<BaseLayout seo={{ url: Astro.url.href }}>
  <a
    href='#contenido'
    class='absolute top-0 left-0 z-50 -translate-y-full bg-accent px-4 py-3 font-mono text-sm text-canvas uppercase focus-visible:translate-y-0'
  >
    Saltar al contenido
  </a>
  <div class='mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-16 lg:px-24 lg:py-0'>
    <div class='lg:flex lg:justify-between lg:gap-4'>
      <Sidebar sections={sections} />

      <main id='contenido' class='pt-24 lg:w-[54%] lg:py-24'>
        <Section id='sobre-mi' title='Sobre mí'>
          <div class='flex flex-col gap-4'>
            <p>
              Product developer en <a href='https://www.audiense.com' target='_blank' rel='noopener noreferrer' class='font-medium text-ink hover:text-accent'>Audiense</a>
              desde 2023. Antes, desarrollador de software en Lean Mind.
            </p>
            <p>
              En los <a href='#articulos' class='font-medium text-ink hover:text-accent'>artículos</a> escribo sobre arquitectura y
              buenas prácticas.
            </p>
          </div>
        </Section>

        <Section id='experiencia' title='Experiencia'>
          <ExperienceList />
        </Section>

        <Section id='stack' title='Stack'>
          <Stack />
        </Section>

        <Section id='articulos' title='Artículos'>
          <ArticleList posts={posts} />
        </Section>

        <footer class='pb-16 font-mono text-sm text-ink-faint sm:pb-0'>
          © {new Date().getFullYear()} Manuel Pérez Regalado · Hecho con Astro y Tailwind CSS
        </footer>
      </main>
    </div>
  </div>
</BaseLayout>
