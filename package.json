{
  "name": "my-gatsby-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "My Astro Site",
  "author": "Manuel Pérez Regalado",
  "keywords": [
    "astro"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome check . && stylelint \"**/*.css\"",
    "format": "biome check --write . && stylelint \"**/*.css\" --fix"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "astro": "^7.4.2",
    "flowbite-react": "^0.8.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "stylelint": "^14.16.1",
    "stylelint-config-standard": "^24.0.0",
    "tailwindcss": "^3.4.19"
  }
}
